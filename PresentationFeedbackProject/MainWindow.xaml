<Window x:Class="PresentationFeedbackUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech Practice"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4FAF8">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28"
                        Height="22"
                        Background="{StaticResource MintBrush}"
                        BorderBrush="{StaticResource BlackBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Margin="0,0,8,0">
                    <TextBlock Text="··"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="18"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-6,0,0"/>
                </Border>

                <TextBlock Text="PRESENTATION PRACTICE"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="13"
                           FontWeight="Black"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Stepper -->
            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Width="560">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="StepCircle1"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource MintBrush}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black"/>
                    </Border>
                    <TextBlock x:Name="StepText1" Text=" 업로드" FontWeight="Bold" Foreground="{StaticResource MintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Height="2" Background="#DDDDDD" Margin="14,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border x:Name="StepCircle2"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#DDDDDD">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="StepText2" Text=" 분석 중" FontWeight="SemiBold" Foreground="#777777" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="3" Height="2" Background="#DDDDDD" Margin="14,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border x:Name="StepCircle3"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#DDDDDD">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="StepText3" Text=" 분석 결과" FontWeight="SemiBold" Foreground="#777777" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="5" Height="2" Background="#DDDDDD" Margin="14,0"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Border x:Name="StepCircle4"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#DDDDDD">
                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="StepText4" Text=" 총점" FontWeight="SemiBold" Foreground="#777777" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Account Action -->
            <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="로그아웃"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="96"
                        Height="38"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Grid>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
