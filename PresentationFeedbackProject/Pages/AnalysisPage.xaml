<Page x:Class="PresentationFeedbackUI.Pages.AnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Margin="0,0,22,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="← 발표 영상"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="17"
                       FontWeight="Black"/>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,8,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BlackBrush}"
                            CornerRadius="14,14,0,0">
                        <TextBlock Text="VIDEO PREVIEW"
                                   Foreground="{StaticResource WhiteBrush}"
                                   FontSize="34"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1"
                          Background="{StaticResource BlackBrush}">
                        <TextBlock Text="▶  01:23 / 04:12"
                                   Foreground="{StaticResource WhiteBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="22,0,0,0"/>

                        <TextBlock Text="⚙  ⛶"
                                   Foreground="{StaticResource WhiteBrush}"
                                   FontSize="18"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,22,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="타임라인 분석"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="18"
                               FontWeight="Black"/>

                    <Grid Grid.Row="1"
                          Margin="0,8,0,0">
                        <Border Height="8"
                                Background="#E5E5E5"
                                CornerRadius="4"
                                VerticalAlignment="Center"/>

                        <Border Height="8"
                                Width="185"
                                Background="{StaticResource MintBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        <Border Width="10"
                                Height="10"
                                Background="{StaticResource BlackBrush}"
                                CornerRadius="5"
                                Margin="120,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        <Border Width="10"
                                Height="10"
                                Background="{StaticResource BlackBrush}"
                                CornerRadius="5"
                                Margin="250,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        <Border Width="10"
                                Height="10"
                                Background="{StaticResource BlackBrush}"
                                CornerRadius="5"
                                Margin="420,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock Text="0:00"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Text="1:00"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="2:00"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="● SPEED"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,18,0"/>

                        <TextBlock Text="● EYE CONTACT"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,18,0"/>

                        <TextBlock Text="● GESTURE"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,18,0"/>

                        <TextBlock Text="● CONTENT"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="128"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="분석 결과 요약"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="20"
                       FontWeight="Black"/>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="18"
                    Margin="0,8,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="62"
                          Height="62">
                        <Ellipse Fill="{StaticResource MintLightBrush}"/>
                        <TextBlock Text="SPEED"
                                   FontSize="9"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding WpmText}"
                                   FontSize="28"
                                   FontWeight="Black"/>

                        <TextBlock Text="권장 범위 100~160 WPM"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <Grid Height="8"
                              Margin="0,14,0,0">
                            <Border Background="#E5E5E5"
                                    CornerRadius="4"/>

                            <Border Background="{StaticResource MintBrush}"
                                    Width="{Binding SpeechRateBarWidth}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="2"
                          Width="64"
                          Height="64">
                        <Ellipse Stroke="{StaticResource MintBrush}"
                                 StrokeThickness="5"/>

                        <TextBlock Text="{Binding SpeechRateScoreText}"
                                   FontSize="12"
                                   FontWeight="Black"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="EYE CONTACT"
                                   FontWeight="Black"/>
                        <TextBlock Text="{Binding EyeContactScoreText}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="GESTURE"
                                   FontWeight="Black"/>
                        <TextBlock Text="{Binding GestureScoreText}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="SILENCE"
                                   FontWeight="Black"/>
                        <TextBlock Text="{Binding SilenceScoreText}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <TextBlock Text="CONTENT"
                                   FontWeight="Black"/>
                        <TextBlock Text="{Binding ContentScoreText}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="3"
                    Content="총점 보기"
                    Style="{StaticResource PrimaryButton}"
                    Height="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="ScoreButton_Click"/>
        </Grid>
    </Grid>
</Page>