<Page x:Class="PresentationFeedbackUI.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Intro -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#BFDCD4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="44"
                Margin="0,0,14,0">

            <StackPanel VerticalAlignment="Center">
                <Border Width="84"
                        Height="6"
                        Background="{StaticResource MintBrush}"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,28"/>

                <TextBlock Text="PRESENTATION"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="46"
                           FontWeight="Black"/>

                <TextBlock Text="FEEDBACK"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="46"
                           FontWeight="Black"/>

                <TextBlock Text="발표 영상, 음성, 대본을 한 번에 분석하고&#x0a;개인 계정별 기록으로 다시 확인하세요."
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           LineHeight="30"
                           Margin="0,28,0,34"/>

                <Grid Width="460"
                      Height="170"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource WhiteBrush}"
                            BorderBrush="#CFE1DC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="01"
                                       Foreground="{StaticResource MintBrush}"
                                       FontSize="22"
                                       FontWeight="Black"/>
                            <TextBlock Text="영상 업로드"
                                       Foreground="{StaticResource BlackBrush}"
                                       FontWeight="Black"
                                       Margin="0,18,0,0"/>
                            <TextBlock Text="녹화 파일 선택"
                                       Foreground="{StaticResource TextGrayBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource WhiteBrush}"
                            BorderBrush="#CFE1DC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="02"
                                       Foreground="{StaticResource MintBrush}"
                                       FontSize="22"
                                       FontWeight="Black"/>
                            <TextBlock Text="발표 분석"
                                       Foreground="{StaticResource BlackBrush}"
                                       FontWeight="Black"
                                       Margin="0,18,0,0"/>
                            <TextBlock Text="속도와 대본 확인"
                                       Foreground="{StaticResource TextGrayBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource WhiteBrush}"
                            BorderBrush="#CFE1DC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="03"
                                       Foreground="{StaticResource MintBrush}"
                                       FontSize="22"
                                       FontWeight="Black"/>
                            <TextBlock Text="기록 저장"
                                       Foreground="{StaticResource BlackBrush}"
                                       FontWeight="Black"
                                       Margin="0,18,0,0"/>
                            <TextBlock Text="이전 영상 다시 보기"
                                       Foreground="{StaticResource TextGrayBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Login Card -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Width="390"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="34">
            <StackPanel>
                <TextBlock Text="로그인"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="25"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBox x:Name="UsernameTextBox"
                Style="{StaticResource InputBox}"
                Text="student01"
                Margin="0,0,0,12"/>

                <PasswordBox x:Name="PasswordBox"
                    Style="{StaticResource InputPassword}"
                   Password="1234"
                 Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,22">
                    <CheckBox Content="로그인 상태 유지"
                              Foreground="{StaticResource BlackBrush}"
                              FontSize="12"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>

                    <TextBlock Text="비밀번호 찾기"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="로그인"
                        Style="{StaticResource PrimaryButton}"
                        Height="48"
                        Click="LoginButton_Click"/>

                <TextBlock Text="또는"
                           Foreground="{StaticResource TextGrayBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,18"/>

                <Button Content="게스트로 시작하기"
                        Style="{StaticResource SecondaryButton}"
                        Height="48"
                        Click="GuestButton_Click"/>

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,24,0,0">
                    <TextBlock Text="계정이 없으신가요?"
               Foreground="{StaticResource TextGrayBrush}"
               FontSize="13"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                    <Button Content="회원가입"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{StaticResource MintBrush}"
            FontSize="13"
            FontWeight="Black"
            Cursor="Hand"
            Padding="6,0"
            Click="SignupButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
