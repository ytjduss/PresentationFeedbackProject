<Page x:Class="PresentationFeedbackUI.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Intro -->
        <Border Grid.Column="0"
                Background="{StaticResource MintLightBrush}"
                BorderBrush="{StaticResource BlackBrush}"
                BorderThickness="1.5"
                CornerRadius="18"
                Padding="44"
                Margin="0,0,14,0">

            <Grid>
                <!-- 배경 민트 도형 -->
                <Ellipse Width="260"
                         Height="260"
                         Fill="{StaticResource MintBrush}"
                         Opacity="0.24"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-110,0,0,-80"/>

                <Ellipse Width="160"
                         Height="160"
                         Fill="{StaticResource MintBrush}"
                         Opacity="0.18"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-60,-40"/>

                <TextBlock Text="✦"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="34"
                           FontWeight="Black"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,110,0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PRESENTATION"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="48"
                               FontWeight="Black"/>

                    <TextBlock Text="PRACTICE"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="48"
                               FontWeight="Black"/>

                    <TextBlock Text="발표 영상을 분석하고&#x0a;나만의 강점을 찾아보세요!"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="28"
                               Margin="0,26,0,0"/>

                    <!-- 오른쪽 위 캐릭터 느낌으로 변경한 곰돌이 캐릭터 -->
                    <Grid Width="230"
                          Height="190"
                          HorizontalAlignment="Left"
                          Margin="110,34,0,0">

                        <!-- 몸통 -->
                        <Border Width="118"
                                Height="92"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BlackBrush}"
                                BorderThickness="1.5"
                                CornerRadius="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"/>

                        <!-- 얼굴 -->
                        <Border Width="126"
                                Height="96"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BlackBrush}"
                                BorderThickness="1.5"
                                CornerRadius="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,16,0,0"/>

                        <!-- 귀 -->
                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="{StaticResource WhiteBrush}"
                                 Stroke="{StaticResource BlackBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="-82,4,0,0"/>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="{StaticResource WhiteBrush}"
                                 Stroke="{StaticResource BlackBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="82,4,0,0"/>

                        <!-- 볼 -->
                        <Ellipse Width="20"
                                 Height="14"
                                 Fill="{StaticResource MintBrush}"
                                 Opacity="0.55"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="-58,68,0,0"/>

                        <Ellipse Width="20"
                                 Height="14"
                                 Fill="{StaticResource MintBrush}"
                                 Opacity="0.55"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="58,68,0,0"/>

                        <!-- 눈 -->
                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="{StaticResource BlackBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="-34,54,0,0"/>

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="{StaticResource BlackBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="34,54,0,0"/>

                        <!-- 코/입 -->
                        <Ellipse Width="10"
                                 Height="8"
                                 Fill="{StaticResource BlackBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,67,0,0"/>

                        <TextBlock Text="ᴗ"
                                   Foreground="{StaticResource BlackBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,68,0,0"/>

                        <!-- 손 -->
                        <Ellipse Width="26"
                                 Height="26"
                                 Fill="{StaticResource WhiteBrush}"
                                 Stroke="{StaticResource BlackBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="-92,0,0,42"/>

                        <Ellipse Width="26"
                                 Height="26"
                                 Fill="{StaticResource WhiteBrush}"
                                 Stroke="{StaticResource BlackBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="92,0,0,42"/>

                        <!-- 말풍선 -->
                        <Border Width="74"
                                Height="40"
                                Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource BlackBrush}"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,18,0,0">
                            <TextBlock Text="GOOD!"
                                       Foreground="{StaticResource MintBrush}"
                                       FontSize="12"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 장식 -->
                        <TextBlock Text="✦"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>

                        <TextBlock Text="✦"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,24,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Login Card -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Width="390"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="34">
            <StackPanel>
                <TextBlock Text="로그인"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="25"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBox x:Name="UsernameTextBox"
                Style="{StaticResource InputBox}"
                Text="student01"
                Margin="0,0,0,12"/>

                <PasswordBox x:Name="PasswordBox"
                    Style="{StaticResource InputPassword}"
                   Password="1234"
                 Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,22">
                    <CheckBox Content="로그인 상태 유지"
                              Foreground="{StaticResource BlackBrush}"
                              FontSize="12"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>

                    <TextBlock Text="비밀번호 찾기"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="로그인"
                        Style="{StaticResource PrimaryButton}"
                        Height="48"
                        Click="LoginButton_Click"/>

                <TextBlock Text="또는"
                           Foreground="{StaticResource TextGrayBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,18"/>

                <Button Content="게스트로 시작하기"
                        Style="{StaticResource SecondaryButton}"
                        Height="48"
                        Click="LoginButton_Click"/>

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,24,0,0">
                    <TextBlock Text="계정이 없으신가요?"
               Foreground="{StaticResource TextGrayBrush}"
               FontSize="13"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                    <Button Content="회원가입"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{StaticResource MintBrush}"
            FontSize="13"
            FontWeight="Black"
            Cursor="Hand"
            Padding="6,0"
            Click="SignupButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>