<Page x:Class="PresentationFeedbackUI.Pages.ScorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- Score Main -->
        <StackPanel Grid.Column="0" Margin="40,30,40,0">
            <TextBlock Text="TODAY'S"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="28"
                       FontWeight="Black"/>

            <TextBlock Text="TOTAL SCORE"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="32"
                       FontWeight="Black"/>

            <TextBlock Text="오늘의 발표 분석 총점입니다!"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,8,0,32"/>
            <Grid Width="270" Height="270">
                <Ellipse Stroke="{StaticResource MintLightBrush}"
                         StrokeThickness="28"/>
                <Ellipse Stroke="{StaticResource MintBrush}"
                         StrokeThickness="28"
                         StrokeDashArray="6 2"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="86"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="82"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="/100"
                               Foreground="{StaticResource TextGrayBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource MintBrush}"
                    CornerRadius="18"
                    Padding="20,8"
                    HorizontalAlignment="Left"
                    Margin="235,-20,0,0">
                <TextBlock Text="★ GOOD"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="18"
                           FontWeight="Black"/>
            </Border>

            <Border Style="{StaticResource Card}"
                    Width="552"
                  
                    Padding="20"
                    Margin="0,40,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ʕ•ᴥ•ʔ"
                               FontSize="34"
                               Margin="0,0,18,0"/>
                    <TextBlock Text="전체적으로 안정적인 발표였어요! 특히 자세와 시선 처리가 매우 좋았습니다."
           FontSize="11"
           FontWeight="SemiBold"
           Width="376"
      
           TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Detail Score -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="34"
                Width="560"
                Height="370"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0">
            <StackPanel>
                <TextBlock Text="항목별 점수"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="22"
                           FontWeight="Black"
                           Margin="0,0,0,26"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="말 빠르기" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="235" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="82 /100" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="시선 처리" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="255" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="88 /100" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="손동작" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="210" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="74 /100" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="침묵 구간" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="265" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="90 /100" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="내용" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="245" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="85 /100" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,34">
            <Button Content="새 영상 분석하기 ↻"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0"
                    Click="UploadButton_Click"/>

            <Button Content="결과 저장하기 ↓"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Page>