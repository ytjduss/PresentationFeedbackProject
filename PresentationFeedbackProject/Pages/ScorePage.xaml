<Page x:Class="PresentationFeedbackUI.Pages.ScorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- Score Main -->
        <StackPanel Grid.Column="0" Margin="40,30,40,0">
            <TextBlock Text="TODAY'S"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="28"
                       FontWeight="Black"/>

            <TextBlock Text="TOTAL SCORE"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="32"
                       FontWeight="Black"/>

            <TextBlock Text="오늘의 발표 분석 총점입니다!"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,8,0,32"/>
            <Grid Width="270" Height="270">
                <Ellipse Stroke="{StaticResource MintLightBrush}"
                         StrokeThickness="28"/>
                <Ellipse Stroke="{StaticResource MintBrush}"
                         StrokeThickness="28"
                         StrokeDashArray="6 2"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalScoreText}"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="82"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="/100"
                               Foreground="{StaticResource TextGrayBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource MintBrush}"
                    CornerRadius="18"
                    Padding="20,8"
                    HorizontalAlignment="Left"
                    Margin="173,-20,0,0">
                <TextBlock Text="{Binding GradeBadgeText}"
                           Foreground="{StaticResource WhiteBrush}"
                           FontSize="18"
                           FontWeight="Black"/>
            </Border>

            <Border Style="{StaticResource Card}"
                    Width="470"
                  
                    Padding="20"
                    Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="종합 평가"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="13"
                               FontWeight="Black"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding OverallFeedback}"
           FontSize="11"
           FontWeight="SemiBold"
           Width="410"
      
           TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Width="470"
                    Height="180"
                    Padding="20"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="발표 대본"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="16"
                               FontWeight="Black"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding Transcript}"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LineHeight="18"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Detail Score -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="34"
                Width="560"
                Height="370"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0">
            <StackPanel>
                <TextBlock Text="항목별 점수"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="22"
                           FontWeight="Black"
                           Margin="0,0,0,26"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="말 빠르기" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WpmText}"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="{Binding SpeechRateBarWidth}" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding SpeechRateScoreText}" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="시선 처리" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="{Binding EyeContactBarWidth}" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding EyeContactScoreText}" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="자세/손동작" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="{Binding GestureBarWidth}" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding GestureScoreText}" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="침묵 구간" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="{Binding SilenceBarWidth}" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding SilenceScoreText}" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="내용" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Height="9" Background="#E5E5E5" CornerRadius="5" VerticalAlignment="Center">
                        <Border Background="{StaticResource MintBrush}" Width="{Binding ContentBarWidth}" CornerRadius="5" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding ContentScoreText}" FontWeight="Black" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,34">
            <Button Content="새 영상 분석하기 ↻"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0"
                    Click="UploadButton_Click"/>

            <Button Content="결과 저장하기 ↓"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Page>
