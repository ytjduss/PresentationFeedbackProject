<Page x:Class="PresentationFeedbackUI.Pages.SignupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Intro -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#BFDCD4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="44"
                Margin="0,0,14,0">
            <StackPanel VerticalAlignment="Center">
                <Border Width="84"
                        Height="6"
                        Background="{StaticResource MintBrush}"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,28"/>

                <TextBlock Text="CREATE"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="48"
                           FontWeight="Black"/>

                <TextBlock Text="YOUR ACCOUNT"
                           Foreground="{StaticResource MintBrush}"
                           FontSize="48"
                           FontWeight="Black"/>

                <TextBlock Text="개인 계정으로 분석 결과를 저장하고&#x0a;이전 녹화 영상과 피드백을 다시 확인하세요."
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           LineHeight="30"
                           Margin="0,26,0,0"/>

                <Border Width="360"
                        Background="{StaticResource WhiteBrush}"
                        BorderBrush="#CFE1DC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        HorizontalAlignment="Left"
                        Margin="0,42,0,0">
                    <StackPanel>
                        <TextBlock Text="저장되는 항목"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="15"
                                   FontWeight="Black"/>
                        <TextBlock Text="영상 경로, 총점, 항목별 점수, 피드백, 발표 대본"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Signup Card -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="34">
            <StackPanel>
                <TextBlock Text="회원가입"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="25"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Text="아이디"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="13"
                           FontWeight="Black"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource InputBox}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="이름"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="13"
                           FontWeight="Black"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="DisplayNameTextBox"
                         Style="{StaticResource InputBox}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="비밀번호"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="13"
                           FontWeight="Black"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource InputPassword}"
                             Margin="0,0,0,14"/>

                <TextBlock Text="비밀번호 확인"
                           Foreground="{StaticResource BlackBrush}"
                           FontSize="13"
                           FontWeight="Black"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="PasswordConfirmBox"
                             Style="{StaticResource InputPassword}"
                             Margin="0,0,0,24"/>

                <Button Content="회원가입"
                        Style="{StaticResource PrimaryButton}"
                        Height="48"
                        Click="RegisterButton_Click"/>

                <Button Content="로그인으로 돌아가기"
                        Style="{StaticResource SecondaryButton}"
                        Height="48"
                        Margin="0,12,0,0"
                        Click="BackLoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
