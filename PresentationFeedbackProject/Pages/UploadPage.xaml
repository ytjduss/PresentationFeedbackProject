<Page x:Class="PresentationFeedbackUI.Pages.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="30,0,26,0">

            <TextBlock Text="발표 영상을 업로드해주세요"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="25"
                       FontWeight="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="정확한 분석을 위해 영상은 3분 이상을 권장합니다."
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,26"/>

            <Border Background="{StaticResource MintLightBrush}"
                    BorderBrush="{StaticResource MintBrush}"
                    BorderThickness="1.5"
                    CornerRadius="4"
                    Height="230"
                    Padding="20">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="☁"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="58"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="여기에 파일을 드롭하거나"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="파일을 선택하세요"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="16"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="MP4, MOV, AVI 파일 지원"
                               Foreground="{StaticResource TextGrayBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,26,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource MintLightBrush}"
                            BorderBrush="{StaticResource MintBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="▣"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="발표_최종본.mp4"
                                   Foreground="{StaticResource BlackBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="158MB"
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"/>
                    </StackPanel>

                    <Grid Grid.Column="2"
                          Height="8"
                          VerticalAlignment="Center">
                        <Border Background="#E5E5E5" CornerRadius="4"/>
                        <Border Background="{StaticResource MintBrush}"
                                Width="100"
                                CornerRadius="4"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Grid.Column="3"
                               Text="✓"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="22"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,60,0">

            <Border Style="{StaticResource Card}"
                    Padding="26"
                    Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="분석 항목"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="19"
                               FontWeight="Black"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="◉  말 빠르기 (SPEED)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  시선 처리 (EYE CONTACT)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  손동작 (GESTURE)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  침묵 구간 (SILENCE)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  발표 내용 (CONTENT)"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Button Content="분석 시작하기  →"
                    Style="{StaticResource PrimaryButton}"
                    Height="56"
                    Click="AnalyzeButton_Click"/>
        </StackPanel>
    </Grid>
</Page>