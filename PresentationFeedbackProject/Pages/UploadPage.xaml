<Page x:Class="PresentationFeedbackUI.Pages.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FAFAFA"
      AllowDrop="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <!-- Upload Area -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="30,0,26,0">

            <TextBlock Text="발표 영상을 업로드해주세요"
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="25"
                       FontWeight="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="MP4, MOV, AVI 파일을 선택하거나 드래그해서 업로드할 수 있습니다."
                       Foreground="{StaticResource BlackBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,26"/>

            <!-- Drop Zone -->
            <Border x:Name="DropZoneBorder"
                    Background="{StaticResource MintLightBrush}"
                    BorderBrush="{StaticResource MintBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Height="300"
                    Padding="20"
                    AllowDrop="True"
                    DragEnter="DropZoneBorder_DragEnter"
                    DragLeave="DropZoneBorder_DragLeave"
                    Drop="DropZoneBorder_Drop"
                    MouseLeftButtonDown="DropZoneBorder_MouseLeftButtonDown">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="☁"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="58"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="여기에 영상을 드롭하거나"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="파일 선택 버튼을 눌러주세요"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="16"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="지원 형식: .mp4 / .mov / .avi"
                               Foreground="{StaticResource TextGrayBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>

                    <Button Content="파일 선택"
                            Style="{StaticResource PrimaryButton}"
                            Width="150"
                            Height="44"
                            Margin="0,22,0,0"
                            Click="SelectFileButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Uploaded File Info -->
            <Border x:Name="FileInfoBorder"
                    Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,26,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource MintLightBrush}"
                            BorderBrush="{StaticResource MintBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="▣"
                                   Foreground="{StaticResource MintBrush}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedFileNameText"
                                   Text="선택된 파일 없음"
                                   Foreground="{StaticResource BlackBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="SelectedFileSizeText"
                                   Text=""
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontSize="12"/>
                    </StackPanel>

                    <Grid Grid.Column="2"
                          Height="8"
                          VerticalAlignment="Center">
                        <Border Background="#E5E5E5"
                                CornerRadius="4"/>

                        <Border Background="{StaticResource MintBrush}"
                                Width="100"
                                CornerRadius="4"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Grid.Column="3"
                               Text="✓"
                               Foreground="{StaticResource MintBrush}"
                               FontSize="22"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="UploadStatusText"
                       Text=""
                       Foreground="{StaticResource TextGrayBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Right Panel -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,60,0">

            <Border Style="{StaticResource Card}"
                    Padding="26"
                    Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="분석 항목"
                               Foreground="{StaticResource BlackBrush}"
                               FontSize="19"
                               FontWeight="Black"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="◉  말 빠르기"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  시선 처리"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  손동작"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="◉  침묵 구간"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <!--<TextBlock Text="◉  발표 내용 (CONTENT)"
                               FontSize="14"
                               FontWeight="SemiBold"/>-->
                </StackPanel>
            </Border>

            <Button x:Name="AnalyzeButton"
                    Content="분석 시작하기  →"
                    Style="{StaticResource PrimaryButton}"
                    Height="56"
                    IsEnabled="False"
                    Click="AnalyzeButton_Click"/>
        </StackPanel>
    </Grid>
</Page>